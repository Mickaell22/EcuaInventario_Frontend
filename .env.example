# Copia este archivo como .env y ajusta los valores para tu entorno local.
# NUNCA subas .env al repositorio.

# URL base del backend Django
# - Local (dispositivo físico en la misma red): http://192.168.X.X:8000
# - Emulador Android: http://10.0.2.2:8000
# - Producción (Railway): https://tu-app.railway.app
BASE_URL=http://192.168.1.100:8000

# Entorno (true = producción)
IS_PRODUCTION=false
